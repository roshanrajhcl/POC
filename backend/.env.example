# Copy this file to backend\.env on the computer where you run the backend, then paste your key.
# Never commit or share the real .env. scripts\make_zip.ps1 leaves it out of the zip.
# Do not keep .env inside a OneDrive folder. If you must, set ENV_FILE to a path outside OneDrive.

# Select "gemini", "groq", or "openai".
AI_PROVIDER=gemini

# Gemini (uses keyword search; this app does not request embeddings from Gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Groq (uses keyword search; this app does not request embeddings from Groq).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# To use OpenAI instead, set AI_PROVIDER=openai and configure:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional tuning
AI_TIMEOUT=45
# Browser origins allowed to call the API (comma-separated, no trailing slash).
CORS_ORIGINS=https://poc-dfl.pages.dev
# MAX_ROUNDS=4            suggestions before the assistant escalates
# RAG_TOP_K=6             knowledge excerpts given to the AI
# OPENAI_TEMPERATURE=0.2  leave unset if your model only supports its default
